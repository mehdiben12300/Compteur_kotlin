<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="24dp">

    <TextView
        android:id="@+id/textViewTitre"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="@string/titre"
        android:textColor="#222222"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textViewCompteur"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="40dp"
        android:text="0"
        android:textColor="#000000"
        android:textSize="64sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/buttonIncrementer"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/incrementer"
        android:textSize="20sp" />

    <Button
        android:id="@+id/buttonDecrementer"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/decrementer"
        android:textSize="20sp" />

    <Button
        android:id="@+id/buttonReinitialiser"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/reinitialiser" />

</LinearLayout>